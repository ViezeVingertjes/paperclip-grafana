# Adds Paperclip's optional OpenTelemetry packages to ANY existing Paperclip image, at exactly the versions that image's
# server declares as peerDependencies (Paperclip refuses any other version and then exports nothing).
#
#   podman build -t paperclip-otel -f paperclip-otel/Containerfile --build-arg BASE=<your paperclip image> paperclip-otel
#   docker build -t paperclip-otel -f paperclip-otel/Containerfile --build-arg BASE=<your paperclip image> paperclip-otel
#
# Build args:  BASE      the Paperclip image to extend (default paperclip-local)
#              PROTOCOL  the OTLP protocol you will set in OTEL_EXPORTER_OTLP_PROTOCOL: grpc (default), http/protobuf, http/json
#              APP_DIR   where Paperclip lives in the image (default /app; the server is APP_DIR/server)
#
# The packages sit in /opt/paperclip-otel and are linked into APP_DIR/node_modules, so the server's plain
# `import("@opentelemetry/...")` finds them and pnpm's own tree stays untouched.
ARG BASE=paperclip-local
FROM ${BASE}
ARG PROTOCOL=grpc
ARG APP_DIR=/app

USER root
# Paperclip's Dockerfile ends with a "cloud" stage that adds a nested server/node_modules/.pnpm and breaks the native
# Runner (admission_installation). Say so at build time; the default image is the "production" target.
RUN if [ -d "${APP_DIR}/server/node_modules/.pnpm" ]; then echo "WARNING: base image is Paperclip's cloud stage; native runner runs will fail. Rebuild it with --target production." >&2; fi
# Run-level and native spans (task.*, native.*, runner.*) exist only in builds from mid-October 2026 on; the older stable
# image exports HTTP/DB spans only, which leaves most dashboard rows empty. Warn at build time.
RUN if ! grep -rqs "task.execution_attempt" "${APP_DIR}/server/dist"; then echo "WARNING: this Paperclip build has no run-level spans (task.execution_attempt); most dashboard rows will stay empty. Use a newer image, e.g. ghcr.io/paperclipai/paperclip:nightly or :beta." >&2; fi
RUN set -eux; \
    mkdir -p /opt/paperclip-otel "${APP_DIR}/node_modules/@opentelemetry"; \
    cd /opt/paperclip-otel; \
    npm init -y >/dev/null; \
    PKGS="$(APP_DIR="${APP_DIR}" PROTOCOL="${PROTOCOL}" node -e ' \
      const peers = require(process.env.APP_DIR + "/server/package.json").peerDependencies || {}; \
      const exporter = { "grpc": "grpc", "http/protobuf": "proto", "http/json": "http" }[process.env.PROTOCOL]; \
      if (!exporter) { console.error("PROTOCOL must be grpc, http/protobuf or http/json"); process.exit(1); } \
      const wanted = ["sdk-node", "auto-instrumentations-node", "resources", "semantic-conventions", "exporter-trace-otlp-" + exporter] \
        .map((n) => "@opentelemetry/" + n); \
      const missing = wanted.filter((n) => !peers[n]); \
      if (missing.length) { console.error("this Paperclip does not declare: " + missing.join(", ")); process.exit(1); } \
      console.log(wanted.map((n) => n + "@" + peers[n]).join(" "));')"; \
    echo "installing: ${PKGS}"; \
    npm install --omit=dev --no-audit --no-fund --save-exact ${PKGS}; \
    for spec in ${PKGS}; do \
      name="${spec%@*}"; \
      ln -sfn "/opt/paperclip-otel/node_modules/${name}" "${APP_DIR}/node_modules/${name}"; \
    done

# The base image starts as root, drops to the node user and runs its own entrypoint; nothing else changes.
